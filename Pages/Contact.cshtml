@page
@model MusicPlayer.Pages.ContactModel
@{
    Layout = "_Layout";
}

<h2 style="color: #fff;">Liên hệ & Phản hồi</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<form method="post">
    <div class="form-group">
        <label asp-for="Message.UserName">Tên</label>
        <input asp-for="Message.UserName" class="form-control" readonly />
        <span asp-validation-for="Message.UserName" class="text-danger"></span>

    </div>

    <div class="form-group">
        <label asp-for="Message.UserEmail">Email</label>
        <input asp-for="Message.UserEmail" class="form-control" readonly />
        <span asp-validation-for="Message.UserEmail" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Message.Content">Nội dung</label>
        <textarea asp-for="Message.Content" class="form-control"></textarea>
        <span asp-validation-for="Message.Content" class="text-danger"></span>
    </div>

    <div><button type="submit" class="btn btn-primary">Gửi phản hồi</button></div>
    <div style="margin-bottom: 40px;"></div>
</form>

<div>
    <a asp-page="/History" class="btn btn-secondary">Xem lịch sử phản hồi</a>
</div>

<style>
    .form-group {
        color: #fff;
        font-weight: 700;
    }
</style>