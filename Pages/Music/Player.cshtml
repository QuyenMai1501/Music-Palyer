@page
@model MusicPlayer.Pages.Music.PlayerModel
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    Layout = "_Layout";
    var username = HttpContextAccessor.HttpContext?.Session.GetString("Username");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Song.Title</title>
    <link rel="stylesheet" href="/css/player.css" asp-append-version="true">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&family=Noto+Sans:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="music-player-page">
    <div class="player-wrapper">
        <div class="lyrics-container" id="lyrics-container">
            <h3>Lời bài hát</h3>
        </div>
        <div class="music-container">
            <h2 class="song-name">🎶 @Model.Song.Title</h2>
            <p class="artist">@Model.Song.Artist</p>
            <div class="volume-control">
                <i class="bi bi-volume-up-fill volume-icon"></i>
                <input type="range" id="volume-slider" min="0" max="1" step="0.01" value="1">
            </div>
            <div class="box-disk" id="disk" data-image="@Model.Song.ImagePath"></div>
            <audio id="audio" src="/Music/Player?handler=Play&songId=@Model.Song.Id" type="audio/mpeg" autoplay></audio>
            <div class="music-slider">
                <input type="range" value="0" class="seek-bar" id="seek-bar">
                <span class="current-time" id="currentTime">00:00</span>
                <span class="music-time" id="duration">@Model.SongDuration</span>
            </div>
            <div class="controls">
                <input type="hidden" id="prevSongId" value="@Model.PrevSongId" />
                <input type="hidden" id="nextSongId" value="@Model.NextSongId" />
                <button class="player-btn btn-back" id="prevButton"><i class="fa fa-backward" aria-hidden="true"></i></button>
                <button class="btn-play pause" id="playButton">
                    <span></span>
                    <span></span>
                </button>
                <button class="player-btn btn-next" id="nextButton"><i class="fa fa-forward" aria-hidden="true"></i></button>
            </div>
            <div class="action-buttons">
                @Html.AntiForgeryToken()
                <button class="btn-lyrics" id="lyricsButton">Lời nhạc</button>
                <!-- Thay thế like-container bằng form -->
                @* <div class="like-container">
                    <i id="heartIcon" class="bi @(Model.HasUserLiked ? "bi-suit-heart-fill" : "bi-suit-heart")" data-song-id="@Model.Song.Id"></i>
                    <span id="likeCount">@Model.LikeCount</span>
                </div> *@
                <form id="likeForm" method="post">
                    <input type="hidden" name="songId" value="@Model.Song.Id" />
                    <button type="submit" asp-page-handler="ToggleLike" class="player-btn btn-outline-danger" id="likeBtn">
                        <span id="likeIcon" style="color: @(Model.HasUserLiked ? "red" : "gray")">
                            @(Model.HasUserLiked ? "❤️" : "🤍")
                        </span>
                        <span id="likeCount">@Model.LikeCount</span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script>
        const audio = document.getElementById('audio');
        const playButton = document.getElementById('playButton');
        const disk = document.getElementById('disk');
        const seekBar = document.getElementById('seek-bar');
        const currentTime = document.getElementById('currentTime');
        const durationSpan = document.getElementById('duration');
        const lyricsContainer = document.getElementById('lyrics-container');
        const lyricsButton = document.getElementById('lyricsButton');
        const volumeSlider = document.getElementById('volume-slider');
        const volumeIcon = document.querySelector('.volume-icon');
        let lastVolume = 1;

        const imageUrl = disk.getAttribute('data-image');
        if (imageUrl) {
            disk.style.backgroundImage = `url('${imageUrl}')`;
        } else {
            console.log('Hình ảnh không tìm thấy, sử dụng mặc định');
            disk.style.backgroundImage = `url('/images/default.jpg')`;
        }

        function syncPlayButtonState() {
            if (audio.paused) {
                playButton.classList.add('pause');
                disk.classList.remove('box-disk-play');
            } else {
                playButton.classList.remove('pause');
                disk.classList.add('box-disk-play');
            }
        }

        const playPromise = audio.play();
        if (playPromise !== undefined) {
            playPromise
                .then(() => syncPlayButtonState())
                .catch(error => {
                    console.error('Autoplay failed:', error);
                    syncPlayButtonState();
                });
        }

        playButton.addEventListener('click', () => {
            if (audio.paused) {
                audio.play();
                playButton.classList.remove('pause');
                disk.classList.add('box-disk-play');
            } else {
                audio.pause();
                playButton.classList.add('pause');
                disk.classList.remove('box-disk-play');
            }
        });

        audio.addEventListener('timeupdate', () => {
            const progress = (audio.currentTime / audio.duration) * 100;
            seekBar.value = isNaN(progress) ? 0 : progress;
            currentTime.textContent = formatTime(audio.currentTime);
        });

        seekBar.addEventListener('input', () => {
            const seekTime = (seekBar.value / 100) * audio.duration;
            audio.currentTime = isNaN(seekTime) ? 0 : seekTime;
        });

        function formatTime(seconds) {
            const minutes = Math.floor(seconds / 60);
            const secs = Math.floor(seconds % 60);
            return `${minutes}:${secs < 10 ? '0' : ''}${secs}`;
        }

        volumeSlider.addEventListener('input', () => {
            audio.volume = volumeSlider.value;
            lastVolume = audio.volume;
            const progress = volumeSlider.value * 100;
            volumeSlider.style.background = `linear-gradient(to right, coral ${progress}%, white ${progress}%)`;
            
            if (audio.volume === 0) {
                volumeIcon.classList.remove('bi-volume-up-fill', 'bi-volume-down-fill');
                volumeIcon.classList.add('bi-volume-mute-fill');
            } else if (audio.volume <= 0.5) {
                volumeIcon.classList.remove('bi-volume-up-fill', 'bi-volume-mute-fill');
                volumeIcon.classList.add('bi-volume-down-fill');
            } else {
                volumeIcon.classList.remove('bi-volume-down-fill', 'bi-volume-mute-fill');
                volumeIcon.classList.add('bi-volume-up-fill');
            }
        });

        volumeSlider.addEventListener('change', () => {
            if (parseFloat(volumeSlider.value) === 1) {
                volumeSlider.style.background = 'coral';
            } else {
                const progress = volumeSlider.value * 100;
                volumeSlider.style.background = `linear-gradient(to right, coral ${progress}%, white ${progress}%)`;
            }
        });

        volumeIcon.addEventListener('click', () => {
            if (audio.volume === 0) {
                audio.volume = lastVolume;
                volumeSlider.value = lastVolume;
                const progress = lastVolume * 100;
                volumeSlider.style.background = progress === 100 ? 'coral' : `linear-gradient(to right, coral ${progress}%, white ${progress}%)`;
                if (lastVolume <= 0.5) {
                    volumeIcon.classList.remove('bi-volume-up-fill', 'bi-volume-mute-fill');
                    volumeIcon.classList.add('bi-volume-down-fill');
                } else {
                    volumeIcon.classList.remove('bi-volume-down-fill', 'bi-volume-mute-fill');
                    volumeIcon.classList.add('bi-volume-up-fill');
                }
            } else {
                lastVolume = audio.volume;
                audio.volume = 0;
                volumeSlider.value = 0;
                volumeSlider.style.background = `linear-gradient(to right, coral 0%, white 0%)`;
                volumeIcon.classList.remove('bi-volume-up-fill', 'bi-volume-down-fill');
                volumeIcon.classList.add('bi-volume-mute-fill');
            }
        });

        if (parseFloat(volumeSlider.value) === 1) {
            volumeSlider.style.background = 'coral';
            volumeIcon.classList.add('bi-volume-up-fill');
        } else if (parseFloat(volumeSlider.value) === 0) {
            volumeSlider.style.background = `linear-gradient(to right, coral 0%, white 0%)`;
            volumeIcon.classList.add('bi-volume-mute-fill');
        } else {
            const progress = volumeSlider.value * 100;
            volumeSlider.style.background = `linear-gradient(to right, coral ${progress}%, white ${progress}%)`;
            volumeIcon.classList.add('bi-volume-down-fill');
        }

        lyricsButton.addEventListener('click', () => {
            lyricsContainer.classList.toggle('active');
        });

        
        var lrcContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LrcContent));
        lrcContent = lrcContent.replace(/\\n/g, "\n");

        function parseLRC(text) {
            const lines = text.split(/\r|\n/);
            const pattern = /\[(\d{2}):(\d{2}(?:\.\d{1,3})?)\](.*)/;
            console.log("Các dòng sau khi split:", lines);

            const result = [];
            lines.forEach(line => {
                line = line.trim();
                if (!line) return;
                const match = line.match(pattern);
                if (match) {
                    const minutes = parseInt(match[1], 10);
                    const seconds = parseFloat(match[2]);
                    const time = minutes * 60 + seconds;
                    const content = match[3].trim();
                    result.push({ time: time, content: content });
                } else {
                    console.warn("Không khớp regex:", line);
                }
            });
            return result;
        }

        const lyricsData = parseLRC(lrcContent);
        console.log("Raw lrcContent:", lrcContent);
        if (lyricsData.length > 0) {
            lyricsData.forEach(line => {
                const p = document.createElement("p");
                p.className = "lyric-line";
                p.setAttribute("data-time", line.time);
                p.textContent = line.content;
                lyricsContainer.appendChild(p);
            });
        } else {
            const p = document.createElement("p");
            p.textContent = "Chưa có lời bài hát";
            lyricsContainer.appendChild(p);
        }

        audio.addEventListener('timeupdate', () => {
            const currentTime = audio.currentTime;
            const lines = document.querySelectorAll(".lyric-line");
            for (let i = 0; i < lyricsData.length; i++) {
                const currentLineTime = lyricsData[i].time;
                const nextLineTime = (i < lyricsData.length - 1) ? lyricsData[i + 1].time : Infinity;
                if (currentTime >= currentLineTime && currentTime < nextLineTime) {
                    lines.forEach(line => {
                        line.classList.remove('active');
                    });
                    if (lines[i]) {
                        lines[i].classList.add('active');
                        if (lyricsContainer.classList.contains('active')) {
                            lines[i].scrollIntoView({ behavior: "smooth", block: "center" });
                        }
                    }
                    break;
                }
            }
        });
    </script>

    <script>
        document.getElementById('likeForm').addEventListener('submit', function (e) {
            e.preventDefault();
            var form = this;
            var formData = new FormData(form);

            fetch(window.location.pathname + '?handler=ToggleLike', {
                method: 'POST',
                body: formData,
            })
            .then(response => response.json())
            .then(data => {
                // Cập nhật icon và số like trực tiếp
                document.getElementById('likeIcon').textContent = data.hasUserLiked ? "❤️" : "🤍";
                document.getElementById('likeIcon').style.color = data.hasUserLiked ? "red" : "gray";
                document.getElementById('likeCount').innerText = data.likeCount;
            });
        });
    </script>

    <script>
        document.getElementById('prevButton').addEventListener('click', function () {
            var prevSongId = document.getElementById('prevSongId').value;
            if (prevSongId) {
                window.location.href = '/Music/Player?songId=' + prevSongId;
            }
        });
        document.getElementById('nextButton').addEventListener('click', function () {
            var nextSongId = document.getElementById('nextSongId').value;
            if (nextSongId) {
                window.location.href = '/Music/Player?songId=' + nextSongId;
            }
        });
    </script>
</body>
</html>