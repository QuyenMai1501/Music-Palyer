@page
@model IndexModel
@inject MusicPlayer.Services.MusicService _musicService
@{
    ViewData["Title"] = "Home page";
}
<style>
    /* Định vị container của bài hát */
    .song-grid .song-card {
        display: inline-block;
        position: relative;
        text-align: center;
        color: white;
        margin-right: 50px;
    }

    .song-grid .song-card img {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
        padding: 10px;
        object-fit: cover;
    }
    
    /* Style cho link chứa hình ảnh và caption */
    .song-grid .song-card .song-link {
        position: relative;
        display: inline-block;
    }

    /* Style cho hình ảnh */
    .song-grid .song-card .song-link img {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
        padding: 10px;
        object-fit: cover;
        display: block;
    }

    /* Căn giữa chữ trên ảnh */
    .song-grid .song-card .song-link figcaption {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: white;
        font-weight: bold;
        text-align: center;
        /* Thêm background bán trong suốt để chữ nổi rõ */
        background-color: rgba(0, 0, 0, 0.5);
        padding: 5px 10px;
        border-radius: 10px;
        word-break: break-word;
    }
    .song-row {
        display: flex;
        justify-content: center;
        margin-bottom: 20px;
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["SuccessMessage"]
    </div>
}

<h2 style="color: white;">🎵 Nhạc Nổi Bật Trong Tuần</h2>
<div class="song-grid">
    @for (int row = 0; row < 2; row++)
    {
        <div class="song-row">
            @for (int col = 0; col < 5; col++)
            {
                int index = row * 5 + col;
                if (index < Model.TrendingSongs.Count)
                {
                    var song = Model.TrendingSongs[index];
                    var playCountThisWeek = _musicService.GetPlayCountThisWeek(song.Id);
                    var likeCountThisWeek = _musicService.GetLikeCountThisWeek(song.Id);

                    <figure class="song-card">
                        <a href="/Music/Player?songId=@song.Id">
                            <img src="@song.ImagePath" alt="@song.Title">
                        </a>
                        <figcaption>
                            @song.Title<br />
                            <small>@song.Artist</small>
                        </figcaption>
                        <p>👂 @playCountThisWeek | ❤️ @likeCountThisWeek</p>
                    </figure>
                }
            }
        </div>
    }
</div>

