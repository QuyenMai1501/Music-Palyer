@page "{token?}"
@model MusicPlayer.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<h2 style="color: white;">Đặt lại mật khẩu</h2>


@if (!Model.PasswordResetSuccess)
{
    <form method="post">
        <div class="form-group">
            <label asp-for="Password" style="color: white;">Mật khẩu mới</label>
            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <br />
        <div class="form-group">
            <label asp-for="ConfirmPassword" style="color: white;">Xác nhận mật khẩu mới</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <br />
        <button asp-page="/Login" type="submit" class="btn btn-primary">Đặt lại mật khẩu</button>
    </form>
}

@if (Model.PasswordResetSuccess)
{
    <div class="alert alert-success" role="alert">
        🎉 Mật khẩu của bạn đã được thay đổi thành công.<br />
        <a href="/Account/Login" class="btn btn-success mt-2">➡ Đăng nhập ngay</a>
    </div>
}
