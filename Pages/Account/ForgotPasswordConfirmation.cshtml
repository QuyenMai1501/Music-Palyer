@page
@model MusicPlayer.Pages.Account.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Xác nhận Quên mật khẩu";
    var resetLink = TempData["ResetLink"] as string;
    var emailExists = TempData["EmailExists"] as bool?;
}
<h2 style="color: white;">Xác nhận</h2>

@if (emailExists.HasValue && !emailExists.Value)
{
    <p style="color: white;">Không tìm thấy tài khoản nào với email đã nhập.</p>
}
else
{
    <p style="color: white;">Nếu email của bạn đã được đăng ký, bạn sẽ sớm nhận được liên kết khôi phục mật khẩu qua email.</p>
}

@if (!string.IsNullOrEmpty(resetLink))
{
    <div class="alert alert-info">
        <strong>Link reset: </strong>
        <a href="@resetLink">@resetLink</a>
    </div>
}

<a href="/Account/ForgotPassword" class="btn-btn-secondary mt-3" style="color: white;">⬅ Quay lại trang quên mật khẩu</a>